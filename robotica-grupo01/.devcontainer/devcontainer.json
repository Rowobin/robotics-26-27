{
  // VS Code -> "Dev Containers: Reopen in Container".
  // You get an editor, a terminal and a debugger running INSIDE the container,
  // with ROS already sourced. Your code still lives in ../src on your Mac.
  "name": "Robotics 02000537 - Lite 6 / ROS 2 Jazzy",
  "dockerComposeFile": ["../docker-compose.yml"],
  "service": "lab",
  "workspaceFolder": "/home/ros/dev_ws",
  "remoteUser": "ros",
  "overrideCommand": false,
  // Leave the container running when you close VS Code, so terminals opened
  // with ./lab.sh shell stay alive.
  "shutdownAction": "none",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools-extension-pack",
        "ms-python.python",
        "ms-iot.vscode-ros",
        "redhat.vscode-yaml",
        "redhat.vscode-xml",
        "twxs.cmake"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "files.associations": {
          "*.urdf": "xml",
          "*.xacro": "xml",
          "*.sdf": "xml"
        }
      }
    }
  }
}
